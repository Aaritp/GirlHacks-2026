{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/proxy?__path=:path*" }
  ],
  "functions": {
    "api/proxy.ts": { "maxDuration": 300 }
  }
}
